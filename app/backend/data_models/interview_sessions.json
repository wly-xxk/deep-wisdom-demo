{
    "title": "interview_sessions",
    "type": "object",
    "description": "Mock interview session shared context owned by the Interviewer agent",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Auto-increment primary key"
        },
        "user_id": {
            "type": "string",
            "description": "Owner user id (system managed)"
        },
        "jd_id": {
            "type": "integer",
            "description": "Related jd_analyses id"
        },
        "gap_id": {
            "type": "integer",
            "description": "Related gap_analyses id"
        },
        "position": {
            "type": "string",
            "description": "Position title for display"
        },
        "company": {
            "type": "string",
            "description": "Company name for display"
        },
        "abilities": {
            "type": "object",
            "description": "Ability matrix snapshot as a JSONB list"
        },
        "gaps": {
            "type": "object",
            "description": "Gap analysis snapshot as a JSONB list"
        },
        "abilities_examined": {
            "type": "object",
            "description": "Ability ids already examined as a JSONB list"
        },
        "abilities_remaining": {
            "type": "object",
            "description": "Ability ids not yet examined as a JSONB list"
        },
        "current_ability_id": {
            "type": "string",
            "description": "Ability id currently being examined"
        },
        "dialogue": {
            "type": "object",
            "description": "Full interview dialogue with tool_calls and decisions as a JSONB list"
        },
        "round_count": {
            "type": "integer",
            "description": "Number of interviewer rounds so far"
        },
        "status": {
            "type": "string",
            "description": "Session status: ongoing or finished"
        },
        "report": {
            "type": "object",
            "description": "Review report generated by the Reviewer agent"
        }
    },
    "required": [
        "jd_id",
        "user_id"
    ]
}